page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  color: #333;
  font-size: 28rpx;
}
.container { padding: 24rpx; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.header { text-align: center; margin: 32rpx 0 16rpx; }
.store-name { font-size: 40rpx; font-weight: 700; }
.store-addr { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.form-group { margin-bottom: 32rpx; }
.label { display: block; font-size: 28rpx; color: #666; margin-bottom: 12rpx; }
.input {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
}
.picker {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
}
.submit-btn {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-top: 16rpx;
}
.error { color: #e64340; font-size: 24rpx; margin-top: 12rpx; }
