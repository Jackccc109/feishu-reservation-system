<!-- pages/mine/mine.wxml -->
<view class="container">
  <view class="header">
    <view class="h-title">我的预约</view>
    <view class="h-sub" wx:if="{{openid}}">已微信登录，展示我的全部预约</view>
    <view class="h-sub" wx:else>请先微信登录后查看</view>
  </view>

  <!-- 未登录：引导去登录 -->
  <view wx:if="{{!openid && !loading}}" class="card empty">
    <view class="empty-icon">🔐</view>
    <view class="empty-text">登录后才能查看我的预约</view>
    <button class="submit-btn" bindtap="goReserve">去登录</button>
  </view>

  <!-- 已登录但无预约 -->
  <view wx:elif="{{list.length === 0 && !loading}}" class="card empty">
    <view class="empty-icon">📭</view>
    <view class="empty-text">还没有预约记录</view>
    <button class="submit-btn" bindtap="goReserve">去预约</button>
  </view>

  <!-- 预约列表 -->
  <view wx:else class="list">
    <view class="card" wx:for="{{list}}" wx:key="code">
      <view class="card-top">
        <text class="store">{{item.storeName || '门店预约'}}</text>
        <text class="badge {{statusClass[item.status]}}">{{statusText[item.status] || item.status}}</text>
      </view>
      <view class="row" wx:if="{{item.activityTitle}}"><text class="label">活动</text><text class="val">{{item.activityTitle}}</text></view>
      <view class="row"><text class="label">日期</text><text class="val">{{item.date}}</text></view>
      <view class="row"><text class="label">时段</text><text class="val">{{item.timeSlot}}</text></view>
      <view class="row"><text class="label">姓名</text><text class="val">{{item.name}}</text></view>
      <view class="row"><text class="label">人数</text><text class="val">{{item.partySize}}人</text></view>
      <view class="row" wx:if="{{item.scene}}"><text class="label">场景</text><text class="val">{{item.scene}}</text></view>
      <view class="row"><text class="label">排队号</text><text class="val">第 {{item.queueNumber}} 位</text></view>
      <view class="codes">
        <text class="code-pill">预约码 {{item.code}}</text>
        <text class="code-pill">签到码 {{item.signinCode}}</text>
      </view>
      <!-- 签到二维码（到店出示给店员核销） -->
      <view class="qr-block" wx:if="{{item.qrUrl}}">
        <text class="qr-tip">到店出示此码给店员核销</text>
        <image class="qr-img" src="{{item.qrUrl}}" mode="aspectFit" show-menu-by-longpress="{{true}}"></image>
      </view>
    </view>
  </view>

  <!-- 员工入口：管理端（扫一扫签到 + 预约管理），需账号密码登录 -->
  <view class="staff-entry" bindtap="goStaff">
    <text class="staff-entry-text">员工入口（扫一扫签到 / 预约管理）</text>
  </view>
</view>
