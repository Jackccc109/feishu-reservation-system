/* pages/mine/mine.wxss */
.header { text-align: center; margin: 24rpx 0 8rpx; }
.h-title { font-size: 40rpx; font-weight: 700; }
.h-sub { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.empty { text-align: center; padding: 48rpx 32rpx; }
.empty-icon { font-size: 64rpx; }
.empty-text { color: #999; margin: 16rpx 0 24rpx; }

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.store { font-size: 30rpx; font-weight: 600; }
.badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
}
.st-pending { background: #ff9500; }
.st-done { background: #07c160; }
.st-cancel { background: #999; }

.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.row:last-of-type { border-bottom: none; }
.label { color: #999; font-size: 26rpx; }
.val { color: #333; font-size: 26rpx; }

.codes {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}
.code-pill {
  background: #f0f9f4;
  color: #07c160;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}
/* 签到二维码 */
.qr-block {
  margin-top: 20rpx;
  text-align: center;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}
.qr-tip { font-size: 22rpx; color: #999; display: block; margin-bottom: 12rpx; }
.qr-img { width: 240rpx; height: 240rpx; }

/* 员工入口 */
.staff-entry {
  margin-top: 32rpx;
  text-align: center;
  padding: 20rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  border: 1rpx dashed #d9d9d9;
}
.staff-entry-text { font-size: 26rpx; color: #666; }
