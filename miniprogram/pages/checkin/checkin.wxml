<!-- pages/checkin/checkin.wxml -->
<view class="container">
  <view class="card">
    <view class="tabs">
      <view class="tab {{activeTab==='scan'?'active':''}}" data-tab="scan" bindtap="switchTab">扫码签到</view>
      <view class="tab {{activeTab==='code'?'active':''}}" data-tab="code" bindtap="switchTab">验证码</view>
      <view class="tab {{activeTab==='phone'?'active':''}}" data-tab="phone" bindtap="switchTab">手机尾号</view>
    </view>

    <view wx:if="{{activeTab==='scan'}}" class="scan-box">
      <button class="scan-btn" bindtap="scanCode">📷 点击扫码签到</button>
      <text class="scan-hint">对准顾客预约成功页的二维码</text>
    </view>

    <view wx:if="{{activeTab==='code'}}" class="form-group">
      <text class="label">签到验证码</text>
      <input class="input" placeholder="请输入6位签到验证码" value="{{signinCode}}" bindinput="onSigninCode" maxlength="6" />
      <button class="submit-btn" bindtap="submitCode" loading="{{loading}}">确认签到</button>
    </view>

    <view wx:if="{{activeTab==='phone'}}" class="form-group">
      <text class="label">手机号后4位</text>
      <input class="input" type="number" placeholder="请输入手机尾号" value="{{phoneTail}}" bindinput="onPhoneTail" maxlength="4" />
      <button class="submit-btn" bindtap="submitPhone" loading="{{loading}}">确认签到</button>
    </view>

    <view wx:if="{{error}}" class="error">{{error}}</view>

    <view wx:if="{{result}}" class="result-box">
      <view class="result-title">✓ {{result.message}}</view>
      <view class="result-sub">{{result.reservation.name}} · {{result.reservation.timeSlot}} · 排队号{{result.reservation.queueNumber}}</view>
      <view class="result-method">签到方式：{{result.method}}</view>
    </view>
  </view>
</view>
