/* pages/admin/admin.wxss */
.admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.admin-title { font-size: 34rpx; font-weight: 700; }
.date-picker { font-size: 26rpx; color: #666; background: #f7f7f7; padding: 12rpx 20rpx; border-radius: 10rpx; }
.stats { display: flex; margin-bottom: 24rpx; }
.stat-item { flex: 1; text-align: center; padding: 16rpx 0; background: #f8fafc; border-radius: 12rpx; margin: 0 6rpx; }
.stat-num { display: block; font-size: 40rpx; font-weight: 700; color: #07c160; }
.stat-label { font-size: 22rpx; color: #999; }
.scan-btn {
  background: #07c160; color: #fff; border-radius: 12rpx;
  font-size: 30rpx; margin-bottom: 24rpx; padding: 18rpx 0;
}
.search-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.search-input { flex: 1; background: #f7f7f7; border-radius: 10rpx; padding: 16rpx; font-size: 26rpx; }
.search-btn { background: #07c160; color: #fff; font-size: 26rpx; padding: 0 28rpx; border-radius: 10rpx; line-height: 64rpx; }
.filter-row { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 8rpx; }
.filter-tag { font-size: 24rpx; color: #666; background: #f0f0f0; padding: 10rpx 24rpx; border-radius: 30rpx; }
.filter-tag.active { background: #07c160; color: #fff; }
.list-item { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03); }
.item-top { display: flex; justify-content: space-between; align-items: center; }
.item-name { font-size: 30rpx; font-weight: 600; }
.item-status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; }
.status-pending { background: #fff7e6; color: #fa8c16; }
.status-checked_in { background: #f0fff6; color: #07c160; }
.status-cancelled { background: #f5f5f5; color: #999; }
.item-info { font-size: 26rpx; color: #333; margin-top: 10rpx; }
.item-sub { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.empty { text-align: center; color: #999; font-size: 26rpx; padding: 60rpx 0; }
