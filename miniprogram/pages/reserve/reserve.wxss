/* pages/reserve/reserve.wxss */

/* 微信登录提示条 */
.login-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
}
.login-bar.logged {
  background: #f0f9f4;
  border-color: #b7eb8f;
}
.login-bar-text { font-size: 26rpx; color: #d46b08; }
.login-bar.logged .login-bar-text { color: #389e0d; }
.login-btn {
  background: #07c160;
  color: #fff;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin: 0;
}

/* 分享按钮 */
.share-btn {
  margin-top: 16rpx;
  background: #07c160;
  color: #fff;
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 0 24rpx;
}

/* 活动归属提示 */
.store-act {
  font-size: 24rpx;
  color: #07c160;
  margin-top: 6rpx;
  font-weight: 600;
}
