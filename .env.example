# ===== 飞书多维表格配置 =====
# 从飞书开放平台创建应用获取: https://open.feishu.cn/
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格的 app_token（从飞书 Base URL 中获取）
# 例如: https://base.feishu.cn/BITABLE/appXXXXX → app_token = BITABLEappXXXXX
FEISHU_APP_TOKEN=BITABLEappxxxxxxxxxxxxxxxxxxxx

# 数据表 ID（从飞书 Base API 文档调试台获取，或 URL 中的 table 参数）
FEISHU_TABLE_ID=tblxxxxxxxxxxxxxxxxxxxx

# ===== 门店配置（首次播种默认门店；各门店标题/地址/时段在管理后台「员工管理 → 配置门店」维护） =====
STORE_CODE=default
STORE_NAME=优品生活馆
STORE_ADDRESS=北京市朝阳区建国路88号
# 每个时段最多可预约的组数（默认 1）
MAX_PER_SLOT=1

# ===== 管理端（员工账号统一管理，存 data/staff.json，首次用以下配置播种） =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改为强密码
# 管理员绑定手机号（查看顾客完整手机号时接收短信验证码）
ADMIN_PHONE=13800000000

# ===== 短信服务（查看顾客完整手机号用） =====
# 不配置 SMS_PROVIDER 时验证码打印到服务端控制台（开发调试用）
# 生产环境推荐阿里云短信：
# SMS_PROVIDER=aliyun
# SMS_ALIYUN_ACCESS_KEY_ID=xxxx
# SMS_ALIYUN_ACCESS_KEY_SECRET=xxxx
# SMS_ALIYUN_SIGN_NAME=门店签名
# SMS_ALIYUN_TEMPLATE_CODE=SMS_xxxx（模板内容含 ${code} 变量）

# ===== 微信小程序（可选，不配则小程序登录功能不可用） =====
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 服务配置 =====
PORT=3000

# 部署到外网的公开访问地址（用于生成正确的二维码链接）
BASE_URL=https://your-app.com
